{
  "permissions": {
    "allow": [
      "Workflow(sv-investigate)",
      "Workflow(sv-explore-approach)",
      "Workflow(sv-prototype-ui)",
      "Workflow(sv-design)",
      "Workflow(sv-implement)",
      "Workflow(sv-comprehensive-review)",
      "Workflow(sv-review-plan)",
      "Workflow(sv-review-changes)",
      "Read(~/.claude/roles/**)",
      "Read(~/.claude/workflows/**)",
      "Read(~/.claude/stacks/**)",
      "Edit(tmp/**)",
      "Edit(~/tmp/wf-runs/**)",
      "Bash(git rev-parse *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(diff *)",
      "Bash(date *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/workflows/mailbox/hook.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/workflows/mailbox/hook.sh\"" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/workflows/mailbox/hook.sh\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/workflows/mailbox/hook.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.claude/workflows/mailbox/hook.sh\"", "asyncRewake": true, "timeout": 3600 }
        ]
      }
    ]
  }
}
